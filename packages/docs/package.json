{
	"name": "@haneullabs/docs",
	"version": "0.1.73",
	"description": "LLM-friendly documentation for the Haneul TypeScript SDK ecosystem",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GeunhwaJeong/haneul-ts-sdks.git"
	},
	"bugs": {
		"url": "https://github.com/GeunhwaJeong/haneul-ts-sdks/issues"
	},
	"homepage": "https://sdk.haneul-labs.com",
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "typedoc && next build && pnpm run build:docs",
		"build:docs": "node scripts/build-docs.ts --all",
		"dev": "next dev",
		"start": "next start",
		"postinstall": "fumadocs-mdx",
		"test": "node scripts/validate-llm-docs.ts",
		"validate-docs": "node scripts/validate-llm-docs.ts",
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"oxlint:check": "oxlint  .",
		"oxlint:fix": "oxlint --fix",
		"lint": "pnpm run oxlint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"dependencies": {
		"@haneullabs/aws-kms-signer": "workspace:*",
		"@haneullabs/bcs": "workspace:*",
		"@haneullabs/dapp-kit-core": "workspace:*",
		"@haneullabs/dapp-kit-react": "workspace:*",
		"@haneullabs/byeol": "workspace:*",
		"@haneullabs/enoki": "workspace:*",
		"@haneullabs/enoki-connect": "workspace:*",
		"@haneullabs/gcp-kms-signer": "workspace:*",
		"@haneullabs/kiosk": "workspace:*",
		"@haneullabs/ledger-signer": "workspace:*",
		"@haneullabs/payment-kit": "workspace:*",
		"@haneullabs/seal": "workspace:*",
		"@haneullabs/signers": "workspace:*",
		"@haneullabs/slush-wallet": "workspace:*",
		"@haneullabs/haneul": "workspace:*",
		"@haneullabs/haneulns": "workspace:*",
		"@haneullabs/utils": "workspace:*",
		"@haneullabs/wallet-standard": "workspace:*",
		"@haneullabs/walrus": "workspace:*",
		"@haneullabs/webcrypto-signer": "workspace:*",
		"@haneullabs/zksend": "workspace:*",
		"@tanstack/react-query": "^5.101.4",
		"fast-glob": "^3.3.3",
		"fumadocs-core": "16.14.4",
		"fumadocs-docgen": "^3.1.0",
		"fumadocs-mdx": "15.2.3",
		"fumadocs-typescript": "^5.3.0",
		"fumadocs-ui": "16.14.4",
		"next": "^16.3.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"postcss": ">=8.5.23",
		"tailwindcss": "^4.3.3",
		"typedoc": "^0.28.20",
		"typedoc-plugin-mermaid": "^1.12.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
